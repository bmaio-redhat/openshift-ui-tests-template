{
  "name": "openshift-ui-tests-template",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "lint": "eslint playwright --color",
    "lint:fix": "npm run lint -- --fix",
    "playwright-install": "playwright install chromium",
    "playwright-report": "playwright show-report ./playwright/test-results/html-report",
    "test-playwright": "playwright test --config=playwright.config.ts",
    "test-playwright-debug": "DEBUG_MODE=1 playwright test --config=playwright.config.ts",
    "test-playwright-headed": "playwright test --config=playwright.config.ts --headed",
    "test-playwright-ui": "playwright test --config=playwright.config.ts --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-prettier": "^4.0.0",
    "prettier": "^2.5.1",
    "ts-node": "10.x",
    "typescript": "5.9.3"
  }
}
