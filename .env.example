# OpenShift Web Console URL
BRIDGE_BASE_ADDRESS=http://localhost:9000

# kubeadmin credentials
BRIDGE_HTPASSWD_USERNAME=kubeadmin
BRIDGE_KUBEADMIN_PASSWORD=

# Identity provider name shown on the login page (default: kube:admin)
BRIDGE_HTPASSWD_IDP=kube:admin

# Cluster API URL (used by oc commands in tests)
CLUSTER_URL=

# Test namespace created/used by tests
TEST_NS=pw-test-ns

# Set to any non-empty value to run browser in headed mode
HEADED=

# Set to 1 to enable debug mode (headed + skip cleanup)
DEBUG_MODE=

# Parallelism — defaults to 4 workers
WORKERS=
